# ---------------------------------------------------------------------------
# WebNetChecker — environment configuration
# Copy to `.env.local` and adjust. All values below have safe defaults.
# ---------------------------------------------------------------------------

# Default HTTP check timeout (milliseconds).
CHECK_TIMEOUT_MS=3000

# Maximum number of targets allowed in a single scan.
SCAN_MAX_TARGETS=50

# Maximum number of concurrent outbound checks in the pool.
SCAN_CONCURRENCY=10

# Rate limit: number of scans allowed per window, per client IP.
RATE_LIMIT_SCANS=10

# Rate limit window (milliseconds).
RATE_LIMIT_WINDOW_MS=60000

# Number of retries when a check times out.
CHECK_RETRIES=1

# Site URL used for metadata / Open Graph / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared secret used to protect the scan endpoint in production.
# Leave empty to disable. When set, clients must send `x-scan-key: <value>`.
SCAN_API_KEY=

# Optional: Redis connection string for distributed rate limiting on Vercel.
# When empty, an in-memory store is used (fine for single-instance deploys).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=