# ---------------------------------------------------------------------------
# WebNetChecker — environment configuration
# Copy to `.env.local` and adjust. All values below have safe defaults.
# ---------------------------------------------------------------------------

# Default HTTP check timeout (milliseconds).
CHECK_TIMEOUT_MS=3000

# Maximum number of targets allowed in a single scan.
SCAN_MAX_TARGETS=200

# Maximum number of concurrent outbound checks in the pool.
SCAN_CONCURRENCY=10

# Rate limit: number of scans allowed per window, per client key.
RATE_LIMIT_SCANS=10

# Rate limit window (milliseconds).
RATE_LIMIT_WINDOW_MS=60000

# Global reserve bucket: max scans per window for the whole process.
# Bounds abuse even when client keys are spoofed/rotated (see TRUST_PROXY).
RATE_LIMIT_GLOBAL=60

# Set to 1 when running behind a trusted reverse proxy (nginx, Vercel):
# client key = LAST entry of x-forwarded-for (the proxy appends the real IP).
# Leave 0 on direct `next start` deployments: proxy headers are untrusted and
# the global reserve bucket is the real abuse barrier.
TRUST_PROXY=0

# Number of retries when a check times out.
CHECK_RETRIES=1

# Site URL used for metadata / Open Graph / sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: shared secret protecting POST /api/scan for external callers
# (cron, scripts). When set, clients must send `x-scan-key: <value>`.
# The dashboard UI is not affected: it calls POST /api/scan/run, which applies
# the key server-side.
SCAN_API_KEY=

# Optional: Redis connection string for distributed rate limiting on Vercel.
# When empty, an in-memory store is used (fine for single-instance deploys).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
